rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() { 
      return request.auth != null;
    }
    
    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function uidUnchanged() { 
      return !('uid' in request.resource.data) || 
        request.resource.data.uid == request.auth.uid;
    }
    
    function uidNotModified() { 
      return !('uid' in request.resource.data) || 
        request.resource.data.uid == resource.data.uid;
    }
    
    function hasRequiredFields(fields) { 
      return request.resource.data.keys().hasAll(fields);
    }
    
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidDailyData(data) {
      return hasOnlyAllowedFields(['uid', 'date', 'schedule', 'todos', 'focusMinutes']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.date is string && data.date.size() == 10 &&
             data.schedule is list && data.schedule.size() <= 100 &&
             data.todos is list && data.todos.size() <= 100 &&
             data.focusMinutes is number && data.focusMinutes >= 0;
    }
    
    function isValidGlobalSettings(data) {
      // Allow optional fields in GlobalSettings
      let allowed = ['learningGoal', 'presetTimes', 'countdownEvent', 'countdownDate', 'dailyLearnGoalHours', 'dailyWorkGoalHours'];
      return request.resource.data.keys().hasAny(allowed) && request.resource.data.keys().hasOnly(allowed) &&
             ( !('learningGoal' in data) || (data.learningGoal is string && data.learningGoal.size() <= 500) ) &&
             ( !('presetTimes' in data) || (data.presetTimes is list && data.presetTimes.size() <= 20) ) &&
             ( !('countdownEvent' in data) || (data.countdownEvent is string && data.countdownEvent.size() <= 50) ) &&
             ( !('countdownDate' in data) || (data.countdownDate is string && data.countdownDate.size() <= 20) ) &&
             ( !('dailyLearnGoalHours' in data) || (data.dailyLearnGoalHours is number && data.dailyLearnGoalHours >= 0 && data.dailyLearnGoalHours <= 24) ) &&
             ( !('dailyWorkGoalHours' in data) || (data.dailyWorkGoalHours is number && data.dailyWorkGoalHours >= 0 && data.dailyWorkGoalHours <= 24) );
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId}/dailyData/{dateId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
                    isValidDailyData(request.resource.data) && 
                    uidUnchanged();
      allow update: if isOwner(userId) && 
                    isValidDailyData(request.resource.data) && 
                    uidNotModified();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/settings/global {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && 
                            isValidGlobalSettings(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
